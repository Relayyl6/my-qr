generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  tier                 String         @default("free") // 'free' | 'pro' | 'plus' | 'ultra'
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?
  isDeactivated        Boolean        @default(false)
  deactivatedAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  links             QrLink[]
  customDomains     CustomDomain[]
  aiCredit          AiCredit?
  aiInvocations     AiInvocation[]
  customerMailLists CustomerMailList[]
}

model QrLink {
  id             String         @id @default(cuid())
  shortCode      String         @unique
  destinationUrl String
  label          String?
  type           String         @default("redirect") // 'redirect' | 'landing-page'
  isArchived     Boolean        @default(false)
  
  scanCount      Int            @default(0)
  lastScannedAt  DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deactivatedUserId String?
  originalLabel     String?

  customDomainId String?
  customDomain   CustomDomain?  @relation(fields: [customDomainId], references: [id], onDelete: SetNull)

  routingRules   RoutingRule[]
  scans          Scan[]
  artworks       QrArtwork[]
  landingPage    LandingPage?

  @@index([shortCode])
  @@index([userId])
  @@index([deactivatedUserId])
  @@index([customDomainId])
}

model RoutingRule {
  id          String   @id @default(cuid())
  qrLinkId    String
  qrLink      QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  priority    Int      @default(0)
  conditions  Json     // { device?: 'ios'|'android'|'desktop', country?: 'NG', timeRange?: {...}, language?: 'en', scanCount?: {gt: 10} }
  destination String
  label       String?
  createdAt   DateTime @default(now())

  @@index([qrLinkId, priority])
}

model Scan {
  id          String   @id @default(cuid())
  qrLinkId    String
  qrLink      QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  country     String?
  city        String?
  device      String?  // 'ios' | 'android' | 'desktop'
  userAgent   String?
  referrer    String?
  ruleFiredId String?  // which RoutingRule matched

  @@index([qrLinkId, scannedAt])
  @@index([scannedAt])
}

model QrArtwork {
  id                String   @id @default(cuid())
  qrLinkId          String
  qrLink            QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  prompt            String
  styleSpec         Json
  imageUrl          String
  compositeUrl      String
  scannabilityScore Int
  createdAt         DateTime @default(now())

  @@index([qrLinkId])
}

model LandingPage {
  id        String   @id @default(cuid())
  qrLinkId  String   @unique
  qrLink    QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  spec      Json     // { theme, blocks: Block[] }
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AiInvocation {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String   // 'route-resolver', 'analyst', etc.
  promptKey    String   // 'route-resolver.v1'
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs    Int      @default(0)
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AiCredit {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyLimitUsd Decimal  @default(5.00) @db.Decimal(10, 2)
  usedThisMonth   Decimal  @default(0) @db.Decimal(10, 6)
  resetAt         DateTime @default(now())
}

model AiCache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

model CustomDomain {
  id              String   @id @default(cuid())
  domain          String   @unique
  status          String   @default("pending") // 'pending' | 'verified' | 'failed'
  cnameTarget     String   @default("cname.dynamicqr.co")
  verificationTxt String
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  links           QrLink[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([domain])
  @@index([userId])
}

model SiteVisit {
  id           String   @id @default(cuid())
  sessionId    String?  // links to VisitorSession
  path         String
  referrer     String?
  userAgent    String?
  device       String?  // 'ios' | 'android' | 'desktop' | 'tablet'
  browser      String?  // 'safari' | 'chrome' | 'firefox' | 'edge' | 'other'
  os           String?  // 'ios' | 'macos' | 'windows' | 'android' | 'linux' | 'other'
  country      String?
  region       String?  // state / province (more precise than city alone)
  city         String?
  lat          Float?   // latitude from IP geolocation
  lng          Float?   // longitude from IP geolocation
  timezone     String?
  isp          String?  // ISP / org name
  ipHash       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  screenWidth  Int?
  screenHeight Int?
  language     String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([device, createdAt])
  @@index([country, createdAt])
  @@index([sessionId])
}

// One logical visitor session across multiple page views
model VisitorSession {
  id           String   @id @default(cuid())
  ipHash       String?
  country      String?
  region       String?
  city         String?
  lat          Float?
  lng          Float?
  timezone     String?
  isp          String?
  device       String?
  browser      String?
  os           String?
  userAgent    String?
  screenWidth  Int?
  screenHeight Int?
  language     String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  entryPath    String?  // first page visited
  duration     Int?     // session duration in seconds
  pageCount    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       SessionEvent[]

  @@index([createdAt])
  @@index([ipHash])
  @@index([country])
}

// rrweb-style DOM event recording for session replay
model SessionEvent {
  id        String         @id @default(cuid())
  sessionId String
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      Int            // rrweb event type enum
  data      Json           // rrweb event payload (password fields masked)
  timestamp BigInt         // millisecond unix timestamp
  createdAt DateTime       @default(now())

  @@index([sessionId, timestamp])
  @@index([createdAt])
}

// 1. Platform Newsletter Subscribers (Double Opt-In & Compliance)
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String?
  status         String    @default("pending") // 'pending' | 'active' | 'unsubscribed' | 'bounced' | 'complained'
  source         String    @default("footer")  // 'footer' | 'popup' | 'signup' | 'import' | 'admin'
  token          String    @unique @default(cuid())
  consentAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  ipHash         String?
  userAgentHash  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([email])
}

// 2. Platform Broadcast Newsletter Campaigns
model NewsletterCampaign {
  id             String    @id @default(cuid())
  subject        String
  preheader      String?
  bodyHtml       String
  bodyText       String?
  status         String    @default("draft") // 'draft' | 'sending' | 'sent'
  sentAt         DateTime?
  recipientCount Int       @default(0)
  deliveredCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  sentVia        String    @default("gmail") // 'gmail' | 'resend'
  recipients     Json?     // Delivery audit log: [{ email, status, error, sentAt }]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

// 3. Platform Promo System (Campaigns & Multi-Surface Placements)
model PromoCampaign {
  id             String      @id @default(cuid())
  name           String      // Internal name e.g. "Black Friday 2026"
  status         String      @default("live") // 'draft' | 'live' | 'paused' | 'ended'
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int         @default(10)
  headline       String
  body           String?
  imageUrl       String?
  ctaLabel       String      @default("Claim Offer")
  ctaUrl         String      @default("/pricing")
  placements     Json        // ["modal", "banner", "toast", "pricing", "dashboard", "footer"]
  dismissalRule  String      @default("session_cap") // 'session_cap' | '7_days' | 'forever'
  frequencyDays  Int         @default(7)
  audience       String      @default("all") // 'all' | 'free' | 'logged_out'
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  promoCodes     PromoCode[]

  @@index([status, priority])
}

// 4. Promo Discount Codes (Redeemable at Checkout)
model PromoCode {
  id               String         @id @default(cuid())
  code             String         @unique // e.g. "BLACKFRIDAY40"
  campaignId       String?
  campaign         PromoCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  type             String         @default("percent") // 'percent' | 'fixed'
  value            Decimal        @db.Decimal(10, 2)  // 40.00 (%) or 5.00 ($)
  appliesTo        String         @default("all")     // 'all' | 'pro' | 'plus' | 'ultra'
  billingPeriod    String         @default("both")    // 'monthly' | 'annual' | 'both'
  maxRedemptions   Int?
  redemptionsCount Int            @default(0)
  perUserLimit     Int            @default(1)
  expiresAt        DateTime?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([code, active])
}

// 5. Customer Multi-Tenant Mailing Lists (User Feature per Plan)
model CustomerMailList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  doubleOptIn Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts    CustomerMailContact[]
  campaigns   CustomerMailCampaign[]

  @@index([userId])
}

model CustomerMailContact {
  id             String           @id @default(cuid())
  userId         String           // Scoped to tenant
  listId         String
  list           CustomerMailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email          String
  firstName      String?
  status         String           @default("active") // 'pending' | 'active' | 'unsubscribed' | 'bounced'
  source         String           @default("qr_entry")
  token          String           @default(cuid())
  consentAt      DateTime         @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())

  @@unique([listId, email])
  @@index([userId, email])
}

model CustomerMailCampaign {
  id             String           @id @default(cuid())
  userId         String
  listId         String
  list           CustomerMailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  subject        String
  bodyHtml       String
  status         String           @default("draft") // 'draft' | 'sent'
  sentAt         DateTime?
  sentCount      Int              @default(0)
  recipientCount Int              @default(0)
  recipients     Json?            // Delivery audit log: [{ email, status, error, sentAt }]
  createdAt      DateTime         @default(now())

  @@index([userId, status])
}

// 6. Micro-SaaS Modules (vCard, Menu, Form, Wi-Fi, Review, Ticket, Coupon)
model MicroSaasItem {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'vcard' | 'menu' | 'form' | 'wifi' | 'review' | 'ticket' | 'coupon' | 'shortener'
  slug        String   @unique
  title       String
  spec        Json     // Bespoke structured payload
  scansCount  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
  @@index([slug])
}

