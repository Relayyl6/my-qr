generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  tier          String         @default("pro") // 'free' | 'pro' | 'premium'
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  links         QrLink[]
  aiCredit      AiCredit?
  aiInvocations AiInvocation[]
}

model QrLink {
  id             String         @id @default(cuid())
  shortCode      String         @unique
  destinationUrl String
  label          String?
  type           String         @default("redirect") // 'redirect' | 'landing-page'
  isArchived     Boolean        @default(false)
  
  scanCount      Int            @default(0)
  lastScannedAt  DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  routingRules   RoutingRule[]
  scans          Scan[]
  artworks       QrArtwork[]
  landingPage    LandingPage?

  @@index([shortCode])
  @@index([userId])
}

model RoutingRule {
  id          String   @id @default(cuid())
  qrLinkId    String
  qrLink      QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  priority    Int      @default(0)
  conditions  Json     // { device?: 'ios'|'android'|'desktop', country?: 'NG', timeRange?: {...}, language?: 'en', scanCount?: {gt: 10} }
  destination String
  label       String?
  createdAt   DateTime @default(now())

  @@index([qrLinkId, priority])
}

model Scan {
  id          String   @id @default(cuid())
  qrLinkId    String
  qrLink      QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  country     String?
  city        String?
  device      String?  // 'ios' | 'android' | 'desktop'
  userAgent   String?
  referrer    String?
  ruleFiredId String?  // which RoutingRule matched

  @@index([qrLinkId, scannedAt])
  @@index([scannedAt])
}

model QrArtwork {
  id                String   @id @default(cuid())
  qrLinkId          String
  qrLink            QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  prompt            String
  styleSpec         Json
  imageUrl          String
  compositeUrl      String
  scannabilityScore Int
  createdAt         DateTime @default(now())

  @@index([qrLinkId])
}

model LandingPage {
  id        String   @id @default(cuid())
  qrLinkId  String   @unique
  qrLink    QrLink   @relation(fields: [qrLinkId], references: [id], onDelete: Cascade)
  spec      Json     // { theme, blocks: Block[] }
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AiInvocation {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String   // 'route-resolver', 'analyst', etc.
  promptKey    String   // 'route-resolver.v1'
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs    Int      @default(0)
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AiCredit {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyLimitUsd Decimal  @default(5.00) @db.Decimal(10, 2)
  usedThisMonth   Decimal  @default(0) @db.Decimal(10, 6)
  resetAt         DateTime @default(now())
}

model AiCache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}
